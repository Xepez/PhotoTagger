<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PhotoTagger.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhotoTagger"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="PhotoTagger">

    <Grid Padding="12">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            Spacing="12"
            Margin="0,0,0,10">

            <Button
                x:Name="SwitchViewButton"
                Content="Full View"
                Click="SwitchViewButton_Click" />

            <Button
                x:Name="AddFolderButton"
                Content="Add Folder"
                Click="AddFolderButton_Click" />

            <Button
                x:Name="RescanButton"
                Content="Rescan All"
                Click="RescanButton_Click" />

            <ProgressBar
                x:Name="ScanProgress"
                Width="160"
                VerticalAlignment="Center"
                Visibility="Collapsed" />

            <TextBlock
                x:Name="StatusText"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis" />

            <TextBlock
                x:Name="CountText"
                VerticalAlignment="Center"
                FontWeight="SemiBold" />

        </StackPanel>

        <!-- Main Area -->
        <Grid x:Name="MainArea" Grid.Row="1" ColumnSpacing="16">

            <Grid.Resources>
                <!-- Default GridView layout -->
                <ItemsPanelTemplate x:Key="GridItemsPanel">
                    <ItemsWrapGrid Orientation="Horizontal" />
                </ItemsPanelTemplate>

                <!-- Single horizontally scrolling row -->
                <ItemsPanelTemplate x:Key="StripItemsPanel">
                    <ItemsWrapGrid Orientation="Vertical" MaximumRowsOrColumns="1" />
                </ItemsPanelTemplate>

                <!-- Compact thumbnail template for the full row (50% of the grid size) -->
                <DataTemplate x:Key="StripItemTemplate">
                    <StackPanel Width="90" Margin="3">

                        <Border
                            Width="90"
                            Height="70"
                            CornerRadius="3"
                            Background="{ThemeResource LayerFillColorDefaultBrush}">

                            <Grid>
                                <Image
                                    Source="{Binding Thumbnail}"
                                    Stretch="UniformToFill" />

                                <!-- Video badge -->
                                <Border
                                    Background="#99000000"
                                    CornerRadius="3"
                                    Padding="2"
                                    Margin="3"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Visibility="{Binding VideoBadgeVisibility}">
                                    <FontIcon
                                        Glyph="&#xE714;"
                                        Foreground="White"
                                        FontSize="10" />
                                </Border>

                                <!-- Folder badge -->
                                <Border
                                    Background="#99000000"
                                    CornerRadius="3"
                                    Padding="2"
                                    Margin="3"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Visibility="{Binding FolderBadgeVisibility}">
                                    <FontIcon
                                        Glyph="&#xE8B7;"
                                        Foreground="White"
                                        FontSize="10" />
                                </Border>
                            </Grid>

                        </Border>

                        <TextBlock
                            Text="{Binding FileName}"
                            FontSize="11"
                            HorizontalAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            Margin="2,3,2,0" />

                    </StackPanel>
                </DataTemplate>
            </Grid.Resources>

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FilterColumn" Width="Auto" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition x:Name="PreviewColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Filter Panel (collapsible) -->
            <Grid Grid.Column="0" Grid.RowSpan="2" ColumnSpacing="4">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Filter sidebar -->
                <ScrollViewer
                    x:Name="FilterContent"
                    Grid.Column="0"
                    Width="260"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Enabled">

                    <Grid RowSpacing="8" Padding="0,0,12,0">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- File and Type Filtering -->
                        <Expander
                            Grid.Row="0"
                            IsExpanded="True"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch">

                            <Expander.Header>
                                <TextBlock Text="Files" FontSize="16" FontWeight="SemiBold" />
                            </Expander.Header>

                            <StackPanel Spacing="8">

                                <TextBox
                                    x:Name="SearchFileNameBox"
                                    PlaceholderText="Search files..."
                                    TextChanged="SearchFileNameBox_TextChanged" />

                                <ComboBox
                                    x:Name="KindFilter"
                                    HorizontalAlignment="Stretch"
                                    SelectedIndex="0"
                                    SelectionChanged="KindFilter_SelectionChanged">
                                    <ComboBoxItem Content="All" />
                                    <ComboBoxItem Content="Photos only" />
                                    <ComboBoxItem Content="Videos only" />
                                    <ComboBoxItem Content="Folders only" />
                                </ComboBox>

                            </StackPanel>
                        </Expander>

                        <!-- Folder Filtering -->
                        <Expander
                            Grid.Row="1"
                            IsExpanded="True"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch">

                            <Expander.Header>
                                <TextBlock Text="Folders" FontSize="16" FontWeight="SemiBold" />
                            </Expander.Header>

                            <StackPanel Spacing="8">

                                <TextBox
                                    x:Name="FilterFolderSearchBox"
                                    PlaceholderText="Search folders..."
                                    TextChanged="FilterFolderSearchBox_TextChanged" />

                                <ToggleSwitch
                                    x:Name="FilterSelectAllFolders"
                                    MinWidth="0"
                                    IsOn="True"
                                    OnContent="Unselect All"
                                    OffContent="Select All"
                                    Toggled="FilterSelectAllFoldersToggle_Changed" />

                                <ListView
                                    x:Name="FolderList"
                                    MaxHeight="300"
                                    SelectionMode="Multiple"
                                    DisplayMemberPath="Label"
                                    SelectionChanged="FolderList_SelectionChanged" />

                            </StackPanel>
                        </Expander>

                        <!-- Tag Filters -->
                        <Expander
                            Grid.Row="2"
                            IsExpanded="True"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch">

                            <Expander.Header>
                                <TextBlock Text="Tags" FontSize="16" FontWeight="SemiBold" />
                            </Expander.Header>

                            <StackPanel Spacing="8">

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox
                                        x:Name="FilterTagsSearchBox"
                                        Grid.Column="0"
                                        PlaceholderText="Search tags..."
                                        TextChanged="FilterTagsSearchBox_TextChanged" />

                                    <Button
                                        x:Name="FilterResetButton"
                                        Grid.Column="1"
                                        Content="Clear filters"
                                        VerticalAlignment="Stretch"
                                        Click="ClearFiltersButton_Click" />
                                </Grid>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox
                                        x:Name="UntaggedOnly"
                                        Grid.Column="0"
                                        Content="Untagged"
                                        MinWidth="0"
                                        VerticalAlignment="Center"
                                        Checked="FilterTagToggle_Changed"
                                        Unchecked="FilterTagToggle_Changed" />

                                    <ToggleSwitch
                                        x:Name="MatchAllToggle"
                                        Grid.Column="1"
                                        MinWidth="0"
                                        VerticalAlignment="Center"
                                        IsOn="True"
                                        OnContent="ALL tags"
                                        OffContent="ANY tags"
                                        Toggled="FilterTagToggle_Changed" />
                                </Grid>

                                <!-- Tags List -->
                                <ListView
                                    x:Name="TagList"
                                    MaxHeight="400"
                                    SelectionMode="Multiple"
                                    DisplayMemberPath="Label"
                                    SelectionChanged="TagList_SelectionChanged" />

                            </StackPanel>
                        </Expander>

                    </Grid>
                </ScrollViewer>

                <!-- Filter toggle (top-right corner of the sidebar) -->
                <Button
                    x:Name="FilterToggleButton"
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    Padding="8"
                    Background="Transparent"
                    BorderThickness="0"
                    AutomationProperties.Name="Toggle filters"
                    ToolTipService.ToolTip="Hide filters"
                    Click="FilterToggleButton_Click">
                    <FontIcon x:Name="FilterToggleIcon" Glyph="&#xE76B;" FontSize="14" />
                </Button>

            </Grid>

            <!-- Photo/Video Grid (becomes a single scrolling row in full view) -->
            <GridView
                x:Name="MediaGrid"
                Grid.Row="0"
                Grid.Column="1"
                SelectionMode="Extended"
                SelectionChanged="MediaGrid_SelectionChanged">

                <GridView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="180" Margin="6">

                            <Border
                                Width="180"
                                Height="140"
                                CornerRadius="4"
                                Background="{ThemeResource LayerFillColorDefaultBrush}">

                                <Grid>
                                    <Image
                                        Source="{Binding Thumbnail}"
                                        Stretch="UniformToFill" />

                                    <!-- Video badge -->
                                    <Border
                                        Background="#99000000"
                                        CornerRadius="6"
                                        Padding="4"
                                        Margin="6"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Visibility="{Binding VideoBadgeVisibility}">
                                        <FontIcon
                                            Glyph="&#xE714;"
                                            Foreground="White"
                                            FontSize="20" />
                                    </Border>

                                    <!-- Folder badge -->
                                    <Border
                                        Background="#99000000"
                                        CornerRadius="6"
                                        Padding="4"
                                        Margin="6"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Visibility="{Binding FolderBadgeVisibility}">
                                        <FontIcon
                                            Glyph="&#xE8B7;"
                                            Foreground="White"
                                            FontSize="20" />
                                    </Border>
                                </Grid>

                            </Border>

                            <TextBlock
                                Text="{Binding FileName}"
                                HorizontalAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                Margin="4,6,4,0" />

                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>

            </GridView>

            <!-- Preview Panel (collapsible) -->
            <Grid
                x:Name="PreviewPanel"
                Grid.Row="0"
                Grid.Column="2"
                ColumnSpacing="4">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Preview toggle (top-left corner of the preview) -->
                <Button
                    x:Name="PreviewToggleButton"
                    Grid.Column="0"
                    VerticalAlignment="Top"
                    Padding="8"
                    Background="Transparent"
                    BorderThickness="0"
                    AutomationProperties.Name="Toggle preview"
                    ToolTipService.ToolTip="Hide preview"
                    Click="PreviewToggleButton_Click">
                    <FontIcon x:Name="PreviewToggleIcon" Glyph="&#xE76C;" FontSize="14" />
                </Button>

                <!-- Preview + Tag Editor -->
                <Border
                    x:Name="PreviewContent"
                    Grid.Column="1"
                    BorderThickness="1"
                    Padding="12">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Photo and video previews share one cell; code shows whichever applies -->
                        <Grid Grid.Row="0">

                            <Image
                                x:Name="PreviewImage"
                                Stretch="Uniform" />

                            <MediaPlayerElement
                                x:Name="PreviewPlayer"
                                AreTransportControlsEnabled="True"
                                AutoPlay="False"
                                Stretch="Uniform"
                                Visibility="Collapsed" />

                            <!-- Info button (top-right corner of the preview) -->
                            <Button
                                x:Name="InfoButton"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="8"
                                Padding="6"
                                CornerRadius="16"
                                Background="#99000000"
                                BorderThickness="0"
                                Visibility="Collapsed"
                                AutomationProperties.Name="Show file info"
                                ToolTipService.ToolTip="File info">

                                <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="White" />

                                <Button.Flyout>
                                    <Flyout
                                            x:Name="InfoFlyout"
                                            Placement="BottomEdgeAlignedRight"
                                            Opening="InfoFlyout_Opening">

                                        <StackPanel Spacing="10" MaxWidth="320">

                                            <TextBlock Text="Details" FontSize="16" FontWeight="SemiBold" />

                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Path" Opacity="0.7" FontSize="12" />
                                                <TextBlock
                                                    x:Name="InfoPathText"
                                                    TextWrapping="Wrap"
                                                    IsTextSelectionEnabled="True" />
                                            </StackPanel>

                                            <StackPanel x:Name="InfoDimensionsPanel" Spacing="2">
                                                <TextBlock Text="Dimensions" Opacity="0.7" FontSize="12" />
                                                <TextBlock x:Name="InfoDimensionsText" />
                                            </StackPanel>

                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Size" Opacity="0.7" FontSize="12" />
                                                <TextBlock x:Name="InfoSizeText" />
                                            </StackPanel>
                                            
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Extension" Opacity="0.7" FontSize="12" />
                                                <TextBlock x:Name="InfoExtensionText" />
                                            </StackPanel>

                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                        </Grid>

                        <!-- Previous / next through the selected folder (hidden unless a folder is selected) -->
                        <Grid
                            x:Name="FolderNav"
                            Grid.Row="1"
                            Margin="0,8,0,0"
                            ColumnSpacing="8"
                            Visibility="Collapsed">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button
                                x:Name="PrevButton"
                                Grid.Column="0"
                                Click="PrevButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE76B;" FontSize="12" />
                                    <TextBlock Text="Previous" />
                                </StackPanel>
                            </Button>

                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                                <TextBlock
                                    x:Name="NavText"
                                    MaxWidth="400"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />

                                <Button
                                    x:Name="SaveFolderThumbnail"
                                    Click="SaveFolderThumbnail_Click"
                                    Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="12" />
                                        <FontIcon Glyph="&#xE74E;" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Button
                                x:Name="NextButton"
                                Grid.Column="2"
                                Click="NextButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Next" />
                                    <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                </StackPanel>
                            </Button>

                        </Grid>

                        <!-- File name, tags and tag editor (hidden in full view) -->
                        <StackPanel
                            x:Name="PreviewDetails"
                            Grid.Row="2"
                            Margin="0,12,0,0">

                            <TextBlock
                                x:Name="PreviewFileName"
                                Text="No selection"
                                FontSize="18"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Text="Tags"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Margin="0,12,0,4" />

                            <ListView
                                x:Name="PreviewTagList"
                                MaxHeight="160"
                                SelectionMode="None">

                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Grid.Column="0"
                                                Text="{Binding}"
                                                VerticalAlignment="Center"
                                                TextTrimming="CharacterEllipsis" />

                                            <Button
                                                Grid.Column="1"
                                                Tag="{Binding}"
                                                Padding="6,2"
                                                Click="RemoveTag_Click"
                                                ToolTipService.ToolTip="Remove tag">
                                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>

                            </ListView>

                            <TextBlock
                                x:Name="SelectionHint"
                                Text="Select an item to see details and add tags."
                                Opacity="0.7"
                                TextWrapping="Wrap"
                                Margin="0,4,0,0" />

                            <ContentControl
                                x:Name="TagEditorContainer"
                                IsEnabled="False"
                                Margin="0,8,0,0">

                                <StackPanel
                                    x:Name="TagEditor"
                                    Orientation="Horizontal"
                                    Spacing="8">

                                    <AutoSuggestBox
                                        x:Name="TagInput"
                                        Width="220"
                                        PlaceholderText="Add a tag..."
                                        TextChanged="TagInput_TextChanged"
                                        QuerySubmitted="TagInput_QuerySubmitted" />

                                    <Button
                                        Content="Add Tag"
                                        Click="AddTagButton_Click" />

                                </StackPanel>

                            </ContentControl>

                        </StackPanel>

                    </Grid>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</Window>
