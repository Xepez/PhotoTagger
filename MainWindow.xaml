<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PhotoTagger.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhotoTagger"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="PhotoTagger">

    <Grid Padding="12">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            Spacing="12"
            Margin="0,0,0,10">

            <Button
                x:Name="SwitchViewButton"
                Content="Switch View"
                Click="SwitchViewButton_Click" />

            <Button
                x:Name="AddFolderButton"
                Content="Add Folder"
                Click="AddFolderButton_Click" />

            <Button
                x:Name="RescanButton"
                Content="Rescan All"
                Click="RescanButton_Click" />

            <ProgressBar
                x:Name="ScanProgress"
                Width="160"
                VerticalAlignment="Center"
                Visibility="Collapsed" />

            <TextBlock
                x:Name="StatusText"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis" />

            <TextBlock
                x:Name="CountText"
                VerticalAlignment="Center"
                FontWeight="SemiBold" />

        </StackPanel>

        <!-- Main area: filters | thumbnails | preview -->
        <Grid Grid.Row="1" ColumnSpacing="16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Filter sidebar -->
            <ScrollViewer
                Grid.Column="0"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollMode="Enabled">

                <Grid RowSpacing="8" Padding="0,0,12,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Folder Filtering -->
                    <Expander
                        Grid.Row="0"
                        IsExpanded="True"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">

                        <Expander.Header>
                            <TextBlock Text="Folders" FontSize="16" FontWeight="SemiBold" />
                        </Expander.Header>

                        <StackPanel Spacing="8">

                            <TextBox
                                x:Name="FilterFolderSearchBox"
                                PlaceholderText="Search folders..."
                                TextChanged="FilterFolderSearchBox_TextChanged" />

                            <ToggleSwitch
                                x:Name="FilterSelectAllFolders"
                                MinWidth="0"
                                IsOn="True"
                                OnContent="Unselect All"
                                OffContent="Select All"
                                Toggled="FilterSelectAllFoldersToggle_Changed" />

                            <ListView
                                x:Name="FolderList"
                                MaxHeight="300"
                                SelectionMode="Multiple"
                                DisplayMemberPath="Label"
                                SelectionChanged="FolderList_SelectionChanged" />

                        </StackPanel>
                    </Expander>

                    <!-- File and Type Filtering -->
                    <Expander
                        Grid.Row="1"
                        IsExpanded="True"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">

                        <Expander.Header>
                            <TextBlock Text="Filters" FontSize="16" FontWeight="SemiBold" />
                        </Expander.Header>

                        <StackPanel Spacing="8">

                            <TextBox
                                x:Name="SearchFileNameBox"
                                PlaceholderText="Search files..."
                                TextChanged="SearchFileNameBox_TextChanged" />

                            <ComboBox
                                x:Name="KindFilter"
                                HorizontalAlignment="Stretch"
                                SelectedIndex="0"
                                SelectionChanged="KindFilter_SelectionChanged">
                                <ComboBoxItem Content="All" />
                                <ComboBoxItem Content="Photos only" />
                                <ComboBoxItem Content="Videos only" />
                                <ComboBoxItem Content="Folders only" />
                            </ComboBox>

                        </StackPanel>
                    </Expander>

                    <!-- Tag Filters -->
                    <Expander
                        Grid.Row="2"
                        IsExpanded="True"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">

                        <Expander.Header>
                            <TextBlock Text="Tags" FontSize="16" FontWeight="SemiBold" />
                        </Expander.Header>

                        <StackPanel Spacing="8">

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox
                                    x:Name="FilterTagsSearchBox"
                                    Grid.Column="0"
                                    PlaceholderText="Search tags..."
                                    TextChanged="FilterTagsSearchBox_TextChanged" />

                                <Button
                                    x:Name="FilterResetButton"
                                    Grid.Column="1"
                                    Content="Clear filters"
                                    VerticalAlignment="Stretch"
                                    Click="ClearFiltersButton_Click" />
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox
                                    x:Name="UntaggedOnly"
                                    Grid.Column="0"
                                    Content="Untagged Only"
                                    MinWidth="0"
                                    VerticalAlignment="Center"
                                    Checked="FilterTagToggle_Changed"
                                    Unchecked="FilterTagToggle_Changed" />

                                <ToggleSwitch
                                    x:Name="MatchAllToggle"
                                    Grid.Column="1"
                                    MinWidth="0"
                                    VerticalAlignment="Center"
                                    IsOn="True"
                                    OnContent="ALL tags"
                                    OffContent="ANY tags"
                                    Toggled="FilterTagToggle_Changed" />
                            </Grid>

                            <!-- Tags List -->
                            <ListView
                                x:Name="TagList"
                                MaxHeight="400"
                                SelectionMode="Multiple"
                                DisplayMemberPath="Label"
                                SelectionChanged="TagList_SelectionChanged" />

                        </StackPanel>
                    </Expander>

                </Grid>
            </ScrollViewer>

            <!-- Photo/video grid -->
            <GridView
                x:Name="MediaGrid"
                Grid.Column="1"
                SelectionMode="Extended"
                SelectionChanged="MediaGrid_SelectionChanged">

                <GridView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="180" Margin="6">

                            <Border
                                Width="180"
                                Height="140"
                                CornerRadius="4"
                                Background="{ThemeResource LayerFillColorDefaultBrush}">

                                <Grid>
                                    <Image
                                        Source="{Binding Thumbnail}"
                                        Stretch="UniformToFill" />

                                    <!-- Video badge -->
                                    <Border
                                        Background="#99000000"
                                        CornerRadius="6"
                                        Padding="4"
                                        Margin="6"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Visibility="{Binding VideoBadgeVisibility}">
                                        <FontIcon
                                            Glyph="&#xE714;"
                                            Foreground="White"
                                            FontSize="20" />
                                    </Border>

                                    <!-- Folder badge -->
                                    <Border
                                        Background="#99000000"
                                        CornerRadius="6"
                                        Padding="4"
                                        Margin="6"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Visibility="{Binding FolderBadgeVisibility}">
                                        <FontIcon
                                            Glyph="&#xE8B7;"
                                            Foreground="White"
                                            FontSize="20" />
                                    </Border>
                                </Grid>

                            </Border>

                            <TextBlock
                                Text="{Binding FileName}"
                                HorizontalAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                Margin="4,6,4,0" />

                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>

            </GridView>

            <!-- Preview + Tag Editor -->
            <Border
                Grid.Column="2"
                BorderThickness="1"
                Padding="12">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Photo and video previews share one cell; code shows whichever applies -->
                    <Grid Grid.Row="0">

                        <Image
                            x:Name="PreviewImage"
                            Stretch="Uniform" />

                        <MediaPlayerElement
                            x:Name="PreviewPlayer"
                            AreTransportControlsEnabled="True"
                            AutoPlay="False"
                            Stretch="Uniform"
                            Visibility="Collapsed" />

                    </Grid>

                    <!-- Previous / next through the selected folder (hidden unless a folder is selected) -->
                    <Grid
                        x:Name="FolderNav"
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        ColumnSpacing="8"
                        Visibility="Collapsed">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            x:Name="PrevButton"
                            Grid.Column="0"
                            Click="PrevButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE76B;" FontSize="12" />
                                <TextBlock Text="Previous" />
                            </StackPanel>
                        </Button>

                        <TextBlock
                            x:Name="NavText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            TextTrimming="CharacterEllipsis" />

                        <Button
                            x:Name="NextButton"
                            Grid.Column="2"
                            Click="NextButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Next" />
                                <FontIcon Glyph="&#xE76C;" FontSize="12" />
                            </StackPanel>
                        </Button>

                    </Grid>

                    <StackPanel
                        Grid.Row="2"
                        Margin="0,12,0,0">

                        <TextBlock
                            x:Name="PreviewFileName"
                            Text="No selection"
                            FontSize="18"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />

                        <TextBlock
                            x:Name="PreviewFilePath"
                            Margin="0,4,0,0"
                            Opacity="0.7"
                            TextWrapping="Wrap" />

                        <Button
                            x:Name="SaveFolderThumbnail"
                            Click="SaveFolderThumbnail_Click">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Glyph="&#xE74E;" FontSize="12" />
                                <TextBlock Text=" Save To Folder Thumbnail" />
                            </StackPanel>
                        </Button>

                        <TextBlock
                            Text="Tags"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Margin="0,12,0,4" />

                        <ListView
                            x:Name="PreviewTagList"
                            MaxHeight="160"
                            SelectionMode="None">

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{Binding}"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis" />

                                        <Button
                                            Grid.Column="1"
                                            Tag="{Binding}"
                                            Padding="6,2"
                                            Click="RemoveTag_Click"
                                            ToolTipService.ToolTip="Remove tag">
                                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>

                        </ListView>

                        <TextBlock
                            x:Name="SelectionHint"
                            Text="Select an item to see details and add tags."
                            Opacity="0.7"
                            TextWrapping="Wrap"
                            Margin="0,4,0,0" />

                        <ContentControl
                            x:Name="TagEditorContainer"
                            IsEnabled="False"
                            Margin="0,8,0,0">

                            <StackPanel
                                x:Name="TagEditor"
                                Orientation="Horizontal"
                                Spacing="8">

                                <AutoSuggestBox
                                    x:Name="TagInput"
                                    Width="220"
                                    PlaceholderText="Add a tag..."
                                    TextChanged="TagInput_TextChanged"
                                    QuerySubmitted="TagInput_QuerySubmitted" />

                                <Button
                                    Content="Add Tag"
                                    Click="AddTagButton_Click" />

                            </StackPanel>

                        </ContentControl>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>
